# Copy this file to production.env and edit the values before running:
#   ENV_FILE=production.env ./scripts/deploy_cloud_run.sh

# -----------------------------------------------------------------------------
# GCP project and region
# -----------------------------------------------------------------------------
PROJECT_ID=my-gcp-project
REGION=asia-east1

# -----------------------------------------------------------------------------
# Cloud Run service names
# -----------------------------------------------------------------------------
API_SERVICE_NAME=leith-api
WEB_SERVICE_NAME=leith-web

# -----------------------------------------------------------------------------
# Source directories
# -----------------------------------------------------------------------------
API_SOURCE_DIR=/Users/hcchien/code/Aleth/packages/leith-api
WEB_SOURCE_DIR=/Users/hcchien/code/Aleth/packages/leith-web

# -----------------------------------------------------------------------------
# Runtime sizing
# -----------------------------------------------------------------------------
API_CPU=1
API_MEMORY=1Gi
API_MIN_INSTANCES=0
API_MAX_INSTANCES=10

WEB_CPU=1
WEB_MEMORY=1Gi
WEB_MIN_INSTANCES=0
WEB_MAX_INSTANCES=10

# -----------------------------------------------------------------------------
# Networking and exposure
# -----------------------------------------------------------------------------
API_ALLOW_UNAUTHENTICATED=true
WEB_ALLOW_UNAUTHENTICATED=true

# If you leave NEXT_PUBLIC_API_URL empty, deploy_cloud_run.sh will auto-fill it
# with the deployed API Cloud Run URL.
NEXT_PUBLIC_API_URL=

# -----------------------------------------------------------------------------
# Service accounts
# -----------------------------------------------------------------------------
# Example:
# API_SERVICE_ACCOUNT=leith-api-prod@my-gcp-project.iam.gserviceaccount.com
# WEB_SERVICE_ACCOUNT=leith-web-prod@my-gcp-project.iam.gserviceaccount.com
API_SERVICE_ACCOUNT=
WEB_SERVICE_ACCOUNT=

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# db_init.sh creates this Secret Manager secret by default.
API_DB_DSN_SECRET=aleth-db-dsn

# Optional raw gcloud --update-secrets format, comma-separated.
# Example:
# API_CUSTOM_SECRETS=GOOGLE_CLIENT_ID=google-client-id:latest,GOOGLE_CLIENT_SECRET=google-client-secret:latest
API_CUSTOM_SECRETS=
WEB_CUSTOM_SECRETS=

# -----------------------------------------------------------------------------
# Extra env vars
# -----------------------------------------------------------------------------
# Optional raw gcloud --update-env-vars format, comma-separated.
# Example:
# API_CUSTOM_ENV_VARS=LEITH_ADDR=0.0.0.0:8080
# WEB_CUSTOM_ENV_VARS=NODE_ENV=production
# Bootstrap the first L4 verifier(s) with comma-separated DIDs.
# Example:
# API_CUSTOM_ENV_VARS=LEITH_BOOTSTRAP_VERIFIER_DIDS=did:vflow:your-admin-did
API_CUSTOM_ENV_VARS=
WEB_CUSTOM_ENV_VARS=

# -----------------------------------------------------------------------------
# Important current limitation
# -----------------------------------------------------------------------------
# Passkey / WebAuthn settings are hardcoded to localhost in:
#   packages/leith-api/cmd/leithd/main.go
# so production passkeys will not work until RP ID / RP origins are externalized.
